{% render 'partials/head.liquid' %}

<section>
  <div class="filterbalk">
    <button>
      <img src="./assets/filter_icon.svg">
      <span>Filters</span>
    </button>

    <button>
      <img src="./assets/bewaar_icon.svg">
      <span>Bewaar</span>
    </button>

        <button>
      <img src="./assets/kaart_icon.svg">
      <span>Kaart</span>
    </button>
  </div>

    <div class="topPositie">
    <span class="topPositieLabel">Toppositie</span>

    <div class="topCardsContainer">
      {% for house in houses limit:3 %}
        <div class="topCardsList">
        
{% include "partials/enhancedImage.liquid", house: house, limit: 1 %}

  <div class="details-container">
    <span>{{ house.street }} {{ house.house_nr }} {{ house.nr_addition }}</span>
      <div class="stad-prijs">
        <span>{{ house.city }} €{{ house.price }} k.k</span>
  </div>
  </div>
        <span class="makelaar">{{ house.agent }}</span>
  </div>
  {% endfor %}
  </div>

  <div class="resultatenInfoContainer">
    <div class="resultatenInfo">
      {% comment %} Data hoeveelheid koopwoningen ophalen {% endcomment %}
      <p>86.685 koopwoningen</p>
      <p>in Nederland</p>
    </div>
    <button class="sorteer">
      <img src="./assets/sorteer_icon.svg">
      <span>Sorteer</span>
    </button>
  </div>

 {% for house in houses limit: 2%}
  {% render 'partials/listCard.liquid', house: house %}
    {% else %}
  {% endfor %}
</section>

{% render 'partials/foot.liquid' %}
