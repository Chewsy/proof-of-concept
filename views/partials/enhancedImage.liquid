{% for image in house.gallery %}

<picture>
  <source type="image/avif" srcset="https://fdnd-agency.directus.app/assets/{{ image }}?format=avif">
  <source type="image/webp" srcset="https://fdnd-agency.directus.app/assets/{{ image }}?format=webp">
  <img src="https://fdnd-agency.directus.app/assets/{{ image }}" alt="Alternatieve tekst" width="100%">
</picture>

{% endfor %}