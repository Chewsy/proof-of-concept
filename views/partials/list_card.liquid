<div class="list-card">
  <a href="/huis/{{ house.id }}">
    <div class="gallery">
      {% for image in house.gallery limit: 3 %}
      <picture>
        <source type="image/avif" srcset="https://fdnd-agency.directus.app/assets/{{ image }}?format=avif">
        <source type="image/webp" srcset="https://fdnd-agency.directus.app/assets/{{ image }}?format=webp">
        <img src="https://fdnd-agency.directus.app/assets/{{ image }}" alt="Alternatieve tekst" width="100%">
      </picture>
      {% endfor %}
    </div>

    <div class="list-details-container">
      <form action="/favoriet" method="POST">

        <button class="interactie {% if favorieteHuizenIds contains house.id %}favoriet{% endif %}" type="submit"
          name="house_id" value="{{ house.id }}">

          <img src="./assets/hart_icon.svg" alt="Hart icoon">
        </button>
      </form>

      <div class="list-details">
        <div class="list-straat">
          <span>{{ house.street }}</span>
        </div>
        <div class="postcode-stad">
          <span>{{ house.postal_code }}</span>
          <span>{{ house.city }}</span>
        </div>

        <div class="prijs">
          <span>€{{ house.price }} k.k</span>
        </div>

        <div class="list-labels-container">
          <div class="list-label">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" role="presentation"
              viewBox="0 0 48 48" class="mr-1 text-neutral-40">
              <path
                d="M38.5 32.25v-16.5a5 5 0 10-6.25-6.25h-16.5a5 5 0 10-6.25 6.25v16.5a5 5 0 106.25 6.25h16.5a5 5 0 106.25-6.25zm-6.25 3.25h-16.5a5 5 0 00-3.25-3.25v-16.5a5 5 0 003.25-3.25h16.5a5 5 0 003.25 3.25v16.5a5 5 0 00-3.25 3.25zM37 9a2 2 0 11-2 2 2 2 0 012-2zM11 9a2 2 0 11-2 2 2 2 0 012-2zm0 30a2 2 0 112-2 2 2 0 01-2 2zm26 0a2 2 0 112-2 2 2 0 01-2 2z">
              </path>
            </svg>
            <span>{{ house.m2 }}</span>
          </div>

          <div class="list-label">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" role="presentation"
              viewBox="0 0 48 48" class="mr-1 text-neutral-40">
              <path
                d="M11 20l-3.999 5.999h33.998L37 20h3l3.999 5.999L44 26v9.5a1.5 1.5 0 01-1.5 1.5H39v1.5a1.5 1.5 0 01-3 0V37H12v1.5a1.5 1.5 0 01-3 0V37H5.5A1.5 1.5 0 014 35.5V26l.001-.001L8 20h3zm30 9H7v5h34v-5zM38.5 8A1.5 1.5 0 0140 9.5V20l-9-.001V21.5a1.5 1.5 0 01-1.5 1.5h-11a1.5 1.5 0 01-1.5-1.5v-1.501L8 20V9.5A1.5 1.5 0 019.5 8h29zM28 17h-8v3h8v-3zm9-6H11v5.999h6V15.5a1.5 1.5 0 011.5-1.5h11a1.5 1.5 0 011.5 1.5v1.499h6V11z">
              </path>
            </svg>
            <span>{{ house.rooms }}</span>
          </div>

          <div class="list-label">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" role="presentation"
              viewBox="0 0 48 48" class="mr-1 text-neutral-40">
              <path
                d="M23.675 12.891l-6.852 13.063 7.032 1.628.492 7.872 7.31-13.373-7.51-1.63-.472-7.56zm2.45-8.897L27 18l6.274 1.362c1.62.351 2.295 1.818 1.5 3.274l-11.82 21.618c-.529.968-1.01.853-1.079-.248L21 30l-5.714-1.323c-1.612-.373-2.3-1.868-1.529-3.337L25.073 3.767c.511-.975.983-.874 1.052.227z">
              </path>
            </svg>
            <span class="energielabel">{{ house.customEnergielabel }}</span>
          </div>
        </div>
      </div>
      <a class="makelaar-logo">
        <img src="https://cloud.funda.nl/valentina_media/212/684/910.jpg" alt="Your House Makelaardij" width="50"
          height="50">
        {{ house.agent }}
      </a>
    </div>
  </div>
</div>
</a>
</div>